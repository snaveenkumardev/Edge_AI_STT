<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SentriAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_navy</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/blue_icon</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Custom application colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/muted_text</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark_navy</item>
        
        <!-- Global typography - use Google Sans by default -->
        <item name="fontFamily">@font/google_sans</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>
</resources>